# Default LLM provider for agents (gemini | groq)
LLM_PROVIDER=gemini
# Google Gemini API key (primary LLM)
GEMINI_API_KEY=
# Groq API key (fallback LLM)
GROQ_API_KEY=
# Resend API key (email delivery)
RESEND_API_KEY=
# Supabase project URL
SUPABASE_URL=
# Supabase service role key (server/pipeline only, never expose to the browser)
SUPABASE_SERVICE_ROLE_KEY=
# Email address that receives admin alerts and run reports
ADMIN_EMAIL=
